# Copy this file to ".env" for local development. NEVER commit ".env".
NODE_ENV=development
PORT=3000
# Local Postgres or a hosted one (Neon / Render / Railway)
DATABASE_URL=postgres://solar:solar@localhost:5432/solar
# true for hosted databases that require SSL (Neon, Render, Railway)
DATABASE_SSL=false
# Long random string (>= 32 chars). Generate with the command below.JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Key used to derive the demo device secrets (optional; defaults to a value derived from JWT_SECRET)
DEVICE_SECRET_KEY=
# Password given to ALL seeded demo users (set your own!)
SEED_PASSWORD=Solar@2026!Demo
AUTO_SEED=true
# Live data simulator (new reading every 15 minutes for each active installation)
SIMULATOR=true
RETENTION_DAYS=14
# Public base URL (optional, used in Location / pagination links). e.g. https://my-api.onrender.com
PUBLIC_URL=
# Return 404 instead of 403 for out-of-jurisdiction resources (hides existence)
HIDE_OUT_OF_SCOPE=false
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=300
