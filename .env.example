# Copy this file to ".env" for local development. NEVER commit ".env".
NODE_ENV=development
PORT=3000

# Local PostgreSQL or a hosted database
DATABASE_URL=postgres://solar:solar@localhost:5432/solar

# Set true when the hosted database requires SSL
DATABASE_SSL=false

# Use a random secret of at least 32 characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional device-secret key; defaults to a value derived from JWT_SECRET
DEVICE_SECRET_KEY=

# Password for seeded demo users; change it for local development
SEED_PASSWORD=change-this-demo-password

AUTO_SEED=true
SIMULATOR=true
RETENTION_DAYS=14

# Public API base URL (leave blank during local development)
PUBLIC_URL=

# Hide out-of-jurisdiction resources with a 404 response
HIDE_OUT_OF_SCOPE=false

CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=300